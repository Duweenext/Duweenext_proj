{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "bundler",            
    "target": "esnext",
    "lib": ["esnext"],
    "baseUrl": ".",                          
    "paths": {
      "@/*": ["./*"],
      "@/theme": ["./src/theme.ts"],
      "@/src/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    },
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "types/**/*.d.ts"
  ]
}
